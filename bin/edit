#!/bin/bash

shopt -s execfail

# If we're in the VS Code integrated terminal, then send
# the edit to a VS Code frame.
[[ $TERM_PROGRAM == "vscode" ]] && exec code --wait $@

# If we're in an Emacs terminal, then try to open on the existing frame.
[[ -n $INSIDE_EMACS ]] && exec emacsclient -r $@

# Otherwise, try a bunch of edit apps in sequence.
exec emacsclient -t $@
exec micro $@
exec nano $@
exec vi $@

echo "$0: no editor tool found" >&2
exit 1
